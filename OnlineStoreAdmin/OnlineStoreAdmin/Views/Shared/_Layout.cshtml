@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <!-- Add this line inside your <head> section -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-12 col col-sm-12">
                <!-- Grey with black text -->
                <nav class="navbar navbar-expand-sm bg-light navbar-light">
                    <div class="container-fluid">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link active" href="#">
                                    <img src="~/lib/images/Samsung-red.jpg" width="150px" height="80px"/>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active" asp-controller="Product" asp-action="Index">Products</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active" asp-controller="Brand" asp-action="ListBrand">Brands</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active" asp-controller="Type" asp-action="ListType">Types</a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </div>
    <div>
        @RenderBody()
    </div>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
