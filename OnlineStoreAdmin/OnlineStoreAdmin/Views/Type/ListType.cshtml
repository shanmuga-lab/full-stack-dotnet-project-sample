@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using OnlineStoreModel.Models.TypeModels;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model IEnumerable<TypeModel>
            <div class="row mt-3">
                <div class="h1 col-md-12 text-center">
                    List of Types
                </div>
            <div class="row mt-3">
                <div class="col-md-12 text-center">
                    <a class="btn btn-outline-primary" 
                    asp-controller="Type" 
                    asp-action="AddType">Add new Type</a>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-12">
            <table class="table table-primary table-hover w-75 mx-auto">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Type Id</th>
                        <th>Name</th>
                        <th>Modify</th>
                        <th>Delete</th>
                    </tr>
                </thead>
        <tbody class="text-center">
            @if (@Model.Count() > 0)
            {
                @foreach (var type in Model)
                {
                    <tr>
                        <td>@type.Id</td>
                        <td>@type.Name</td>
                        <td><a class="btn btn-outline-secondary"
                             asp-controller="Type"
                             asp-action="ModifyType"
                             asp-route-id="@type.Id"
                             >Modify</a></td>
                        <td><a class="btn btn-outline-danger"
                             asp-controller="Type"
                             asp-action="DeleteType"
                             asp-route-id="@type.Id"
                             >Delete</a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">No types found.</td>
                </tr>
            }
        </tbody>
    </table>
        </div>
    </div>
</div>