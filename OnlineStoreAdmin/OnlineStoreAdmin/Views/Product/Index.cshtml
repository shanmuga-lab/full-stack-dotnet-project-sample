@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using OnlineStoreModel.Models.ProductModels;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<ListProductModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row mt-3">
                <div class="h1 col-md-12 text-center">
                    List of Products
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-12 text-center">
                    <a class="btn btn-outline-primary" 
                    asp-controller="Product" 
                    asp-action="CreateProduct">Add Product</a>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-12">
            <table class="table table-primary table-hover w-75 mx-auto">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Product Id</th>
                        <th>Product Name</th>
                        <th>Product Description</th>
                        <th>Brand</th>
                        <th>Type</th>
                        <th>Image</th>
                        <th>Product Price</th>
                        <th>GST</th>
                        <th>Total Price</th>
                        <th>Modify</th>
                        <th>Delete</th>
                    </tr>
                </thead>
        <tbody class="text-center">
            @if (@Model.Count() > 0)
            {
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.ProductName</td>
                        <td>@product.ProductDescription</td>
                        <td>@product.BrandName</td>
                        <td>@product.TypeName</td>
                        <td><img src="@product.ImageUrl" alt="@product.ImageName" style="width: 100px; height: 100px"/></td>
                        <td>@product.ProductPrice</td>
                        <td>@product.GST</td>
                        <td>@product.TotalPrice</td>
                        <td><a class="btn btn-outline-secondary"
                             asp-controller="Product"
                             asp-action="EditProduct"
                             asp-route-id="@product.Id"
                             >Edit</a></td>
                        <td><a class="btn btn-outline-danger"
                             asp-controller="Product"
                             asp-action="DeleteProduct"
                             asp-route-id="@product.Id"
                             >Delete</a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12">No products found.</td>
                </tr>
            }
        </tbody>
    </table>
                </div>
</div>