@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using OnlineStoreModel.Models.BrandModels;
@model ModifyBrandModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
            <div class="row mt-3">
                <div class="h1 col-md-12 text-center">
                    Modify Brand - @Model.Name
                </div>
            <form method="post" enctype="multipart/form-data">
                <div class="row mt-3">
                    <div class="col-lg-12 mx-auto rounder border p-3 mt-3 text-center">
                        <div class="row mt-3">
                            <div class="col-md-4 text-center">
                                <label asp-for="Id">Brand Id</label>
                            </div>
                            <div class="col-md-8 text-center">
                                <input type="text" class="form-control" asp-for="Id" readonly />
                            </div>
                            <div class="col-md-4 text-center">
                                <label asp-for="Name">Brand Name</label>
                            </div>
                            <div class="col-md-8 text-center">
                                <input type="text" class="form-control" asp-for="Name" required />
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4 text-center">
                        <a class="btn btn-outline-secondary" href="@Url.Action("ListBrand", "Brand")">Cancel</a>
                            </div>
                            <div class="col-md-8 text-center">
                                <button type="submit" class="btn btn-outline-primary"
                                    asp-controller="Brand" 
                                    asp-action="ModifyBrand"
                                    asp-route-id="@Model.Id">Submit</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
              
            </div>